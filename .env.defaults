# Defaults for the RDMO docker compose stack.
#
# To override a value locally, create a ".env" file next to this one and put
# only the keys you want to change in there, e.g.:
#
#   DJANGO_SECRET_KEY=some-random-value
#   POSTGRES_PASSWORD=some-other-password
#
# That ".env" file is git-ignored and always takes precedence over the
# defaults below. Works both with plain "docker compose" and with "task".

GLOBAL_PREFIX=rdc
FINALLY_EXPOSED_PORT=8484
DJANGO_SECRET_KEY=secret_key

# Host folder that holds all persistent/shared data (log files, the postgres
# database, the rdmo-app checkout). Defaults to "./vol" next to this file;
# set an absolute path here to store it elsewhere (e.g. on a different disk).
VOLDIR=./vol

# Docker restart policy (no, on-failure, always, unless-stopped)
# see https://docs.docker.com/compose/compose-file/#restart
RESTART_POLICY=always

# NOTE: BASE_URL does not work, will be fixed later
# by default rdmo is available under the root url
# if you want to run under a subpath set BASE_URL
# i.e. for 'http://yourrdmo.com/rdmo' set the key to '/rdmo'
# BASE_URL=/rdmo

# the list of URLs under which this application is available
ALLOWED_HOSTS=localhost, ip6-localhost, 127.0.0.1, [::1], rdmo, rdc-rdmo, rdmo.ils-geomonitoring.de

# NOTE: avoid "latest" here, pin an actual major version and upgrade
# deliberately. Postgres major-version upgrades need pg_dump/pg_upgrade
# with both binary versions available - they are NOT automatic here, and
# fixperms will back up vol/postgres and refuse to start rather than let a
# version bump silently touch data it can't actually read.
#
# Postgres 18+ also changed where it expects to be mounted: <=17 wants a
# bind mount directly at .../data (POSTGRES_DATA_MOUNT's default below), 18+
# wants a single mount one level up, at /var/lib/postgresql, and manages its
# own version-named subdirectory under that. If you bump POSTGRES_VERSION to
# 18 or newer, also set:
#   POSTGRES_DATA_MOUNT=/var/lib/postgresql
# Only do this for a fresh deployment, or after manually migrating existing
# data (pg_dump from the old version, pg_restore into the new one) - it does
# not on its own convert already-existing <=17 data to the 18+ layout.
POSTGRES_VERSION=16
POSTGRES_DATA_MOUNT=/var/lib/postgresql/data
POSTGRES_USER=rdmo
POSTGRES_PASSWORD=rdmopgpass19
POSTGRES_DB=rdmo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# set a port number below to expose postgres at a certain port on the docker host
POSTGRES_EXPOSED_PORT=

# to install rdmo from github use the entry below
# if it is not set, rdmo's latest release will be installed from pip
# use with caution when switching versions on existing volume data
# migrations might be necessary which can not be undone easily
# it is highly recommended to backup the volume folder first
# also keep in mind that rdmo won't install when it is installed already
# in case of trying to update, it might be easier to do manually inside the container
# RDMO_INSTALL_URL=git+https://github.com/rdmorganiser/rdmo@1.8.2

RDMO_REPO=https://github.com/rdmorganiser/rdmo
RDMO_APP=/vol/rdmo-app
RDMO_APP_REPO=https://github.com/rdmorganiser/rdmo-app
RDMO_CATALOG=/tmp/rdmo-catalog
RDMO_CATALOG_REPO=https://github.com/rdmorganiser/rdmo-catalog

DEFAULT_URI_PREFIX=https://rdmo.dc/instance

VOL=/vol
LOGGING_DIR=/vol/log

# if running behind another reverse proxy, the hostname
# is required to make django set the correct url when sending an email
# caddy sets the x-forwarded-host header using this value
URL_HOSTNAME=rdmo.dc

DELAY_AFTER_GUNICORN_FAILURE=60s
